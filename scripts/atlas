#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
zellij_session="${SKETCHPAD_ZELLIJ_SESSION:-dylan}"
zellij_tab="${SKETCHPAD_ZELLIJ_TAB:-atlas}"
remote_dir="${SKETCHPAD_REMOTE_DIR:-projs/sketchpad}"

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/atlas run <command> [args...]
  scripts/atlas screen [line-count]
  scripts/atlas interrupt
  scripts/atlas sync
  scripts/atlas status
EOF
  exit 2
}

find_atlas_pane() {
  local pane
  pane="$(
    zellij --session "$zellij_session" action list-panes --all |
      awk -v tab="$zellij_tab" \
        '$3 == tab && $5 == "terminal" { print $4; exit }'
  )"

  if [[ -z "$pane" ]]; then
    echo "No active terminal pane found in Zellij tab '$zellij_tab'." >&2
    return 1
  fi

  printf '%s\n' "$pane"
}

run_remote_command() {
  if [[ "$#" -eq 0 ]]; then
    usage
  fi

  "$script_dir/sync-to-atlas"

  local pane marker begin_marker end_marker remote_dir_quoted
  local remote_command argument argument_quoted payload
  local screen_file end_line status

  pane="$(find_atlas_pane)"
  marker="__SKETCHPAD_${$}_${RANDOM}_${SECONDS}__"
  begin_marker="${marker}_BEGIN"
  end_marker="${marker}_END"
  printf -v remote_dir_quoted '%q' "$remote_dir"

  remote_command=""
  for argument in "$@"; do
    printf -v argument_quoted '%q' "$argument"
    remote_command+="$argument_quoted "
  done

  payload="printf '%s\\n' '$begin_marker'; cd \"\$HOME\"/$remote_dir_quoted && $remote_command; __sketchpad_status=\$?; printf '%s:%d\\n' '$end_marker' \"\$__sketchpad_status\""
  screen_file="$(mktemp -t sketchpad-atlas-screen.XXXXXX)"

  cleanup() {
    rm -f "$screen_file"
  }

  interrupt_remote() {
    zellij --session "$zellij_session" action send-keys \
      --pane-id "$pane" "ctrl c" || true
    exit 130
  }

  trap cleanup EXIT
  trap interrupt_remote INT TERM

  zellij --session "$zellij_session" action paste \
    --pane-id "$pane" "$payload"
  zellij --session "$zellij_session" action send-keys \
    --pane-id "$pane" Enter

  while true; do
    zellij --session "$zellij_session" action dump-screen \
      --pane-id "$pane" --full >"$screen_file"
    end_line="$(
      grep -E "^${end_marker}:[0-9]+$" "$screen_file" |
        tail -n 1 || true
    )"
    if [[ -n "$end_line" ]]; then
      break
    fi
    sleep 0.2
  done

  awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin { capture = 1; next }
    capture && index($0, end ":") == 1 { exit }
    capture { print }
  ' "$screen_file"

  status="${end_line##*:}"
  trap - EXIT INT TERM
  cleanup
  return "$status"
}

command="${1:-}"
if [[ -n "$command" ]]; then
  shift
fi

case "$command" in
  run)
    run_remote_command "$@"
    ;;
  screen)
    pane="$(find_atlas_pane)"
    line_count="${1:-40}"
    zellij --session "$zellij_session" action dump-screen \
      --pane-id "$pane" --full |
      tail -n "$line_count"
    ;;
  interrupt)
    pane="$(find_atlas_pane)"
    zellij --session "$zellij_session" action send-keys \
      --pane-id "$pane" "ctrl c"
    ;;
  sync)
    "$script_dir/sync-to-atlas"
    ;;
  status)
    pane="$(find_atlas_pane)"
    printf 'session=%s tab=%s pane=%s\n' \
      "$zellij_session" "$zellij_tab" "$pane"
    ;;
  *)
    usage
    ;;
esac
