#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
remote_host="${SKETCHPAD_REMOTE_HOST:?SKETCHPAD_REMOTE_HOST must name the target host}"
zellij_session="${SKETCHPAD_ZELLIJ_SESSION:-dylan}"
zellij_tab="${SKETCHPAD_ZELLIJ_TAB:-$remote_host}"
remote_dir="${SKETCHPAD_REMOTE_DIR:-projs/sketchpad}"
cargo_build_jobs="${SKETCHPAD_CARGO_BUILD_JOBS:-}"
remote_display="${SKETCHPAD_REMOTE_DISPLAY:-}"
lock_key="$(
  printf '%s-%s' "$zellij_session" "$zellij_tab" |
    tr -cs '[:alnum:]_.-' '_'
)"
remote_pane_lock="${TMPDIR:-/tmp}/sketchpad-zellij-$(id -u)-${lock_key}.lock"

if [[ -n "$cargo_build_jobs" && ! "$cargo_build_jobs" =~ ^[1-9][0-9]*$ ]]; then
  echo "SKETCHPAD_CARGO_BUILD_JOBS must be a positive integer." >&2
  exit 2
fi

usage() {
  cat >&2 <<EOF
usage:
  scripts/$remote_host run <command> [args...]
  scripts/$remote_host screen [line-count]
  scripts/$remote_host interrupt
  scripts/$remote_host sync
  scripts/$remote_host status
  scripts/$remote_host fetch <.artifacts/path> [local-path]
  scripts/$remote_host record [local-trace-path]
  scripts/$remote_host latency [sketchpad-options...]
  scripts/$remote_host benchmark cpu [trace-replay-options...]
  scripts/$remote_host benchmark profile [cpu-profile-options...]
  scripts/$remote_host benchmark gpu <adapter-filter> [gpu-replay-options...]
EOF
  exit 2
}

find_remote_pane() {
  local pane
  pane="$(
    zellij --session "$zellij_session" action list-panes --all |
      awk -v tab="$zellij_tab" \
        '$3 == tab && $5 == "terminal" { print $4; exit }'
  )"

  if [[ -z "$pane" ]]; then
    echo "No active terminal pane found in Zellij tab '$zellij_tab'." >&2
    return 1
  fi

  printf '%s\n' "$pane"
}

acquire_remote_pane_lock() {
  local owner
  while ! mkdir "$remote_pane_lock" 2>/dev/null; do
    if [[ -f "$remote_pane_lock/pid" ]]; then
      owner="$(<"$remote_pane_lock/pid")"
      if [[ "$owner" =~ ^[1-9][0-9]*$ ]] && ! kill -0 "$owner" 2>/dev/null; then
        rm -f "$remote_pane_lock/pid"
        rmdir "$remote_pane_lock" 2>/dev/null || true
        continue
      fi
    fi
    sleep 0.1
  done
  printf '%d\n' "$$" >"$remote_pane_lock/pid"
}

release_remote_pane_lock() {
  rm -f "$remote_pane_lock/pid"
  rmdir "$remote_pane_lock" 2>/dev/null || true
}

run_remote_command() {
  if [[ "$#" -eq 0 ]]; then
    usage
  fi

  local pane marker begin_marker end_marker remote_dir_quoted
  local remote_command argument argument_quoted payload cargo_jobs_export
  local screen_file="" end_line status

  acquire_remote_pane_lock

  cleanup() {
    if [[ -n "${screen_file:-}" ]]; then
      rm -f "$screen_file"
    fi
    release_remote_pane_lock
  }

  trap cleanup EXIT

  SKETCHPAD_REMOTE_HOST="$remote_host" "$script_dir/sync-to-remote"

  pane="$(find_remote_pane)"
  marker="__SKETCHPAD_${remote_host}_${$}_${RANDOM}_${SECONDS}__"
  begin_marker="${marker}_BEGIN"
  end_marker="${marker}_END"
  printf -v remote_dir_quoted '%q' "$remote_dir"

  remote_command=""
  for argument in "$@"; do
    printf -v argument_quoted '%q' "$argument"
    remote_command+="$argument_quoted "
  done

  cargo_jobs_export=""
  if [[ -n "$cargo_build_jobs" ]]; then
    cargo_jobs_export="export CARGO_BUILD_JOBS=$cargo_build_jobs; "
  fi
  payload="if [ -f \"\$HOME/.cargo/env\" ]; then . \"\$HOME/.cargo/env\"; fi; ${cargo_jobs_export}printf '%s\\n' '$begin_marker'; cd \"\$HOME\"/$remote_dir_quoted && $remote_command; __sketchpad_status=\$?; printf '%s:%d\\n' '$end_marker' \"\$__sketchpad_status\""
  screen_file="$(mktemp -t "sketchpad-${remote_host}-screen.XXXXXX")"

  interrupt_remote() {
    zellij --session "$zellij_session" action send-keys \
      --pane-id "$pane" "ctrl c" || true
    exit 130
  }

  trap interrupt_remote INT TERM

  zellij --session "$zellij_session" action paste \
    --pane-id "$pane" "$payload"
  zellij --session "$zellij_session" action send-keys \
    --pane-id "$pane" Enter

  while true; do
    zellij --session "$zellij_session" action dump-screen \
      --pane-id "$pane" --full >"$screen_file"
    end_line="$(
      grep -E "^${end_marker}:[0-9]+$" "$screen_file" |
        tail -n 1 || true
    )"
    if [[ -n "$end_line" ]]; then
      break
    fi
    sleep 0.2
  done

  awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin { capture = 1; next }
    capture && index($0, end ":") == 1 { exit }
    capture { print }
  ' "$screen_file"

  status="${end_line##*:}"
  trap - EXIT INT TERM
  cleanup
  return "$status"
}

validate_artifact_path() {
  local artifact="$1"
  if [[ "$artifact" != .artifacts/* || "/$artifact/" == *"/../"* ]]; then
    echo "Remote artifacts must be beneath .artifacts/ without '..' components." >&2
    return 2
  fi
}

fetch_remote_artifact() {
  if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
    usage
  fi
  local artifact="$1"
  local local_path="${2:-$artifact}"
  local repo_root
  validate_artifact_path "$artifact"
  repo_root="$(git rev-parse --show-toplevel)"
  if [[ "$local_path" != /* ]]; then
    local_path="$repo_root/$local_path"
  fi
  mkdir -p "$(dirname "$local_path")"
  rsync --archive --compress \
    "$remote_host:$remote_dir/$artifact" \
    "$local_path"
}

record_stroke() {
  if [[ "$#" -gt 1 ]]; then
    usage
  fi
  local local_path="${1:-traces/canonical-wacom-v1.json}"
  local file_name remote_artifact
  file_name="$(basename "$local_path")"
  remote_artifact=".artifacts/recordings/$file_name"

  run_remote_command cargo run --release --locked --bin sketchpad -- \
    --record-stroke "$remote_artifact"
  fetch_remote_artifact "$remote_artifact" "$local_path"
  printf 'recorded_trace=%s\n' "$local_path"
}

run_latency_probe() {
  if [[ -n "$remote_display" ]]; then
    run_remote_command env DISPLAY="$remote_display" RUST_LOG=info \
      cargo run --release --locked --bin sketchpad -- "$@"
  else
    run_remote_command env RUST_LOG=info \
      cargo run --release --locked --bin sketchpad -- "$@"
  fi
}

benchmark_suite() {
  if [[ "$#" -lt 1 ]]; then
    usage
  fi
  local kind="$1"
  shift
  local adapter="" label="$kind"
  case "$kind" in
    cpu)
      ;;
    profile)
      label="cpu-profile"
      ;;
    gpu)
      if [[ "$#" -lt 1 ]]; then
        usage
      fi
      adapter="$1"
      shift
      label="gpu-$(printf '%s' "$adapter" | tr -cs '[:alnum:]._- ' '_' | tr -d ' ')"
      ;;
    *)
      usage
      ;;
  esac

  local repo_root revision timestamp stem result_artifact context_artifact
  repo_root="$(git rev-parse --show-toplevel)"
  revision="$(git -C "$repo_root" rev-parse --short=12 HEAD)"
  if [[ -n "$(git -C "$repo_root" status --porcelain --untracked-files=normal)" ]]; then
    revision="${revision}-dirty"
  fi
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  stem="${remote_host}-${label}-${timestamp}-${revision}"
  result_artifact=".artifacts/results/${stem}.jsonl"
  context_artifact=".artifacts/results/${stem}.context.txt"

  run_remote_command scripts/benchmark-preflight
  run_remote_command scripts/benchmark-context "$context_artifact"
  case "$kind" in
    cpu)
      run_remote_command cargo run --release --locked --bin trace_replay -- \
        --trace traces/canonical-wacom-v1.json \
        --output "$result_artifact" \
        --revision "$revision" \
        "$@"
      ;;
    profile)
      run_remote_command cargo run --release --locked --bin cpu_profile_replay -- \
        --trace traces/canonical-wacom-v1.json \
        --output "$result_artifact" \
        --revision "$revision" \
        "$@"
      ;;
    gpu)
      run_remote_command cargo run --release --locked --bin gpu_trace_replay -- \
        --trace traces/canonical-wacom-v1.json \
        --output "$result_artifact" \
        --adapter "$adapter" \
        --revision "$revision" \
        "$@"
      ;;
  esac
  fetch_remote_artifact "$result_artifact"
  fetch_remote_artifact "$context_artifact"
  printf 'benchmark_result=%s\nbenchmark_context=%s\n' \
    "$repo_root/$result_artifact" "$repo_root/$context_artifact"
}

command="${1:-}"
if [[ -n "$command" ]]; then
  shift
fi

case "$command" in
  run)
    run_remote_command "$@"
    ;;
  screen)
    pane="$(find_remote_pane)"
    line_count="${1:-40}"
    zellij --session "$zellij_session" action dump-screen \
      --pane-id "$pane" --full |
      tail -n "$line_count"
    ;;
  interrupt)
    pane="$(find_remote_pane)"
    zellij --session "$zellij_session" action send-keys \
      --pane-id "$pane" "ctrl c"
    ;;
  sync)
    SKETCHPAD_REMOTE_HOST="$remote_host" "$script_dir/sync-to-remote"
    ;;
  status)
    pane="$(find_remote_pane)"
    printf 'host=%s session=%s tab=%s pane=%s remote_dir=%s cargo_build_jobs=%s\n' \
      "$remote_host" "$zellij_session" "$zellij_tab" "$pane" "$remote_dir" \
      "${cargo_build_jobs:-default}"
    ;;
  fetch)
    fetch_remote_artifact "$@"
    ;;
  record)
    record_stroke "$@"
    ;;
  latency)
    run_latency_probe "$@"
    ;;
  benchmark)
    benchmark_suite "$@"
    ;;
  *)
    usage
    ;;
esac
